 1 file changed, 95 insertions(+), 23 deletions(-)

diff --git a/src/cbmpc/protocol/ot.cpp b/src/cbmpc/protocol/ot.cpp
index dffa993..8817dd5 100644
--- a/src/cbmpc/protocol/ot.cpp
+++ b/src/cbmpc/protocol/ot.cpp
@@ -1,3 +1,8 @@
+#include <algorithm>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
 #include <cbmpc/internal/crypto/ro.h>
 #include <cbmpc/internal/protocol/ot.h>
 
@@ -5,6 +10,64 @@ namespace coinbase::mpc {
 
 // ----------------------- base_ot_protocol_pvw_ctx_t -----------------------------------
 
+namespace {
+
+// Number of threads the base OT loops below may use, from the CBMPC_BASE_OT_THREADS environment
+// variable (read once). Unset, or 1, keeps everything on the calling thread, as before.
+int base_ot_threads() {
+  static const int threads = [] {
+    const char* v = std::getenv("CBMPC_BASE_OT_THREADS");
+    const int t = v ? std::atoi(v) : 1;
+    return std::min(std::max(t, 1), 64);
+  }();
+  return threads;
+}
+
+// Runs body(i) for every i in [0, m) and returns the first error by index order of the worker
+// that hit it. The base OT instances are independent of each other: each iteration draws its
+// own randomness and reads and writes only its own index of the vectors involved. So spreading
+// the iterations over threads changes neither the messages sent nor the outputs, only the
+// wall-clock time. Worker threads are outside any variable-time scope of the caller (that state
+// is thread-local), so the point multiplications stay constant-time.
+template <class F>
+error_t for_each_base_ot(int m, F&& body) {
+  const int threads = std::min(base_ot_threads(), m);
+  if (threads <= 1) {
+    for (int i = 0; i < m; i++) {
+      if (error_t rv = body(i)) return rv;
+    }
+    return SUCCESS;
+  }
+
+  std::vector<error_t> results(threads, SUCCESS);
+  std::vector<std::thread> workers;
+  workers.reserve(threads);
+  auto work = [&](int t) {
+    for (int i = t; i < m; i += threads) {
+      if (error_t rv = body(i)) {
+        results[t] = rv;
+        return;
+      }
+    }
+  };
+  for (int t = 1; t < threads; t++) {
+    try {
+      workers.emplace_back(work, t);
+    } catch (...) {
+      // No thread to be had: do that share of the work here.
+      work(t);
+    }
+  }
+  work(0);
+  for (auto& w : workers) w.join();
+  for (error_t rv : results) {
+    if (rv) return rv;
+  }
+  return SUCCESS;
+}
+
+}  // namespace
+
