-  for (int i = 0; i < m; i++) {
-    r[i] = bn_t::rand(q);
-    int bi = static_cast<int>(b[i]);
-    A[i] = r[i] * G[bi];
-    B[i] = r[i] * H[bi];
-  }
+  // Read the choice bits up front: bits_t packs them, the workers below should not share it.
+  std::vector<int> choice(m);
+  for (int i = 0; i < m; i++) choice[i] = static_cast<int>(b[i]);
 
-  return SUCCESS;
+  return for_each_base_ot(m, [&](int i) -> error_t {
+    r[i] = bn_t::rand(q);
+    A[i] = r[i] * G[choice[i]];
+    B[i] = r[i] * H[choice[i]];
+    return SUCCESS;
+  });
 }
 
