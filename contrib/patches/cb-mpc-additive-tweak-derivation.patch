+cbmpc_error_t cbmpc_ecdsa_mp_derive_mul_add_ac(cmem_t ac_key_blob, cmem_t mul, cmem_t add, cmem_t* out_ac_key_blob) {
+  try {
+    if (!out_ac_key_blob) return E_BADARG;
+    *out_ac_key_blob = cmem_t{nullptr, 0};
+    const auto vkb = validate_cmem(ac_key_blob);
+    if (vkb) return vkb;
+    const auto vm = validate_cmem(mul);
+    if (vm) return vm;
+    const auto va = validate_cmem(add);
+    if (va) return va;
+
+    coinbase::buf_t out;
+    const coinbase::error_t rv =
+        coinbase::api::ecdsa_mp::derive_mul_add_ac(view_cmem(ac_key_blob), view_cmem(mul), view_cmem(add), out);
+    if (rv) return rv;
+    return alloc_cmem_from_buf(out, out_ac_key_blob);
+  } catch (const std::bad_alloc&) {
+    if (out_ac_key_blob) *out_ac_key_blob = cmem_t{nullptr, 0};
+    return E_INSUFFICIENT;
+  } catch (...) {
+    if (out_ac_key_blob) *out_ac_key_blob = cmem_t{nullptr, 0};
+    return E_GENERAL;
+  }
+}
