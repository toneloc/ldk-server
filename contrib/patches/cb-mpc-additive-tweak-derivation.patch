                                                                           coinbase::api::detail::MAX_OPAQUE_BLOB_SIZE))
diff --git a/src/cbmpc/c_api/ecdsa2pc.cpp b/src/cbmpc/c_api/ecdsa2pc.cpp
index db7249d..9b437d3 100644
--- a/src/cbmpc/c_api/ecdsa2pc.cpp
+++ b/src/cbmpc/c_api/ecdsa2pc.cpp
@@ -145,6 +145,54 @@ cbmpc_error_t cbmpc_ecdsa_2p_sign(const cbmpc_2pc_job_t* job, cmem_t key_blob, c
   return sign_common(&coinbase::api::ecdsa_2p::sign, job, key_blob, msg_hash, sid_in, sid_out, sig_der_out);
 }
 
+cbmpc_error_t cbmpc_ecdsa_2p_derive_additive_tweak(cmem_t key_blob, cmem_t tweak, cmem_t* out_key_blob) {
+  try {
+    if (!out_key_blob) return E_BADARG;
+    *out_key_blob = cmem_t{nullptr, 0};
+    const auto vkb = validate_cmem(key_blob);
+    if (vkb) return vkb;
+    const auto vtw = validate_cmem(tweak);
+    if (vtw) return vtw;
+
+    coinbase::buf_t out;
+    const coinbase::error_t rv =
+        coinbase::api::ecdsa_2p::derive_additive_tweak(view_cmem(key_blob), view_cmem(tweak), out);
+    if (rv) return rv;
+    return alloc_cmem_from_buf(out, out_key_blob);
+  } catch (const std::bad_alloc&) {
+    if (out_key_blob) *out_key_blob = cmem_t{nullptr, 0};
+    return E_INSUFFICIENT;
+  } catch (...) {
+    if (out_key_blob) *out_key_blob = cmem_t{nullptr, 0};
+    return E_GENERAL;
+  }
+}
+
+cbmpc_error_t cbmpc_ecdsa_2p_derive_mul_add(cmem_t key_blob, cmem_t mul, cmem_t add, cmem_t* out_key_blob) {
+  try {
+    if (!out_key_blob) return E_BADARG;
+    *out_key_blob = cmem_t{nullptr, 0};
+    const auto vkb = validate_cmem(key_blob);
+    if (vkb) return vkb;
+    const auto vm = validate_cmem(mul);
+    if (vm) return vm;
+    const auto va = validate_cmem(add);
+    if (va) return va;
+
+    coinbase::buf_t out;
+    const coinbase::error_t rv =
+        coinbase::api::ecdsa_2p::derive_mul_add(view_cmem(key_blob), view_cmem(mul), view_cmem(add), out);
+    if (rv) return rv;
+    return alloc_cmem_from_buf(out, out_key_blob);
+  } catch (const std::bad_alloc&) {
+    if (out_key_blob) *out_key_blob = cmem_t{nullptr, 0};
+    return E_INSUFFICIENT;
+  } catch (...) {
+    if (out_key_blob) *out_key_blob = cmem_t{nullptr, 0};
+    return E_GENERAL;
+  }
+}
