+cbmpc_error_t cbmpc_ecdsa_2p_derive_additive_tweak(cmem_t key_blob, cmem_t tweak, cmem_t* out_key_blob);
+
+// Locally derive a key blob for `key * mul + add` (32-byte scalars). Public key is
+// mul*Q + add*G. Ephemeral; do not refresh derived blobs. Ownership as above.
+cbmpc_error_t cbmpc_ecdsa_2p_derive_mul_add(cmem_t key_blob, cmem_t mul, cmem_t add, cmem_t* out_key_blob);
+
 // Compute compressed public key for a key blob.
