+error_t derive_mul_add_ac(mem_t ac_key_blob, mem_t mul, mem_t add, buf_t& out_ac_key_blob) {
+  // Local (non-interactive) derivation of `key * mul + add` on an access-structure key share.
+  //
+  // Valid ONLY when the access structure is a single THRESHOLD gate over the parties (plain
+  // Shamir sharing): with f the sharing polynomial and x = f(0), the polynomial mul*f + add
+  // shares mul*x + add, and its value at each party's point is mul*x_i + add. So every party
+  // applies the same map to its own share, and every public share Qi maps to mul*Qi + add*G.
+  // For any quorum the Lagrange coefficients sum to one, so the derived additive shares used
+  // by sign_ac again add up to the derived key. AND/OR structures do not have this property.
+  //
+  // Intended for BOLT 3 per-commitment keys (mul = 1) and revocation keys. All parties must
+  // apply the same (mul, add) to blobs of the same key. Derived blobs are ephemeral and must
+  // not be refreshed.
+  out_ac_key_blob.free();
+  if (const error_t rv = coinbase::api::detail::validate_mem_arg_max_size(ac_key_blob, "ac_key_blob",
+                                                                          coinbase::api::detail::MAX_OPAQUE_BLOB_SIZE))
+    return rv;
+  if (mul.size != 32 || add.size != 32) return coinbase::error(E_BADARG, "mul/add must be 32 bytes");
+
+  error_t rv = UNINITIALIZED_ERROR;
+  key_blob_v1_t blob;
+  if (rv = coinbase::convert(blob, ac_key_blob)) return rv;
+  if (blob.version != ac_key_blob_version_v1) return coinbase::error(E_FORMAT, "not an access-structure key blob");
+
+  const auto cid = static_cast<curve_id>(blob.curve);
+  if (cid == curve_id::ed25519) return coinbase::error(E_FORMAT, "invalid key blob curve");
+  const auto curve = to_internal_curve(cid);
+  if (!curve.valid()) return coinbase::error(E_FORMAT, "invalid key blob curve");
+
+  const coinbase::crypto::mod_t& q = curve.order();
+  const auto& G = curve.generator();
+  const coinbase::crypto::bn_t m = coinbase::crypto::bn_t::from_bin(mul);
+  const coinbase::crypto::bn_t a = coinbase::crypto::bn_t::from_bin(add);
+  if (m == 0 || m >= q) return coinbase::error(E_BADARG, "mul out of range");
+  if (a >= q) return coinbase::error(E_BADARG, "add out of range");
+  if (!q.is_in_range(blob.x_share)) return coinbase::error(E_FORMAT, "invalid key blob");
+
+  const coinbase::crypto::ecc_point_t aG = a * G;
+
+  coinbase::crypto::ecc_point_t Q;
+  if (rv = Q.from_bin(curve, blob.Q_compressed)) return coinbase::error(rv, "invalid key blob");
+  const coinbase::crypto::ecc_point_t Q_derived = m * Q + aG;
+  if (Q_derived.is_infinity() || curve.check(Q_derived)) return coinbase::error(E_CRYPTO, "derived point invalid");
+
+  key_blob_v1_t derived;
+  derived.version = blob.version;
+  derived.curve = blob.curve;
+  derived.party_name = blob.party_name;
+  derived.Q_compressed = Q_derived.to_compressed_bin();
+  for (const auto& kv : blob.Qis_compressed) {
+    coinbase::crypto::ecc_point_t Qi;
+    if (rv = Qi.from_bin(curve, kv.second)) return coinbase::error(rv, "invalid key blob");
+    const coinbase::crypto::ecc_point_t Qi_derived = m * Qi + aG;
+    if (Qi_derived.is_infinity()) return coinbase::error(E_CRYPTO, "derived share point invalid");
+    derived.Qis_compressed[kv.first] = Qi_derived.to_compressed_bin();
+  }
+  MODULO(q) derived.x_share = blob.x_share * m + a;
+
+  out_ac_key_blob = coinbase::convert(derived);
+  return SUCCESS;
+}
