index 142455e..5e39230 100644
--- a/src/cbmpc/api/ecdsa2pc.cpp
+++ b/src/cbmpc/api/ecdsa2pc.cpp
@@ -179,6 +179,79 @@ error_t sign(const coinbase::api::job_2p_t& job, mem_t key_blob, mem_t msg_hash,
   return sign_common(&coinbase::mpc::ecdsa2pc::sign, job, key_blob, msg_hash, sid, sig_der);
 }
 
+error_t derive_additive_tweak(mem_t key_blob, mem_t tweak, buf_t& out_key_blob) {
+  // Local (non-interactive) derivation of `key + tweak`: Q' = Q + tweak*G, and P2 adds the
+  // tweak to its share. P1's share and the Paillier ciphertext c_key = Enc(x1) are unchanged,
+  // exactly as the non-hardened step of hd_keyset_ecdsa_2p::derive_keys does. Both parties
+  // must apply the same tweak to the same key blob to obtain shares of the same derived key.
+  out_key_blob.free();
+  if (const error_t rv = coinbase::api::detail::validate_mem_arg_max_size(key_blob, "key_blob",
+                                                                          coinbase::api::detail::MAX_OPAQUE_BLOB_SIZE))
+    return rv;
+  if (tweak.size != 32) return coinbase::error(E_BADARG, "tweak must be 32 bytes");
+
+  coinbase::mpc::ecdsa2pc::key_t key;
+  if (const error_t rv = deserialize_key_blob(key_blob, key)) return rv;
+
+  const mod_t& q = key.curve.order();
+  const auto& G = key.curve.generator();
+  const bn_t t = bn_t::from_bin(tweak);
+  if (t == 0 || t >= q) return coinbase::error(E_BADARG, "tweak out of range");
+
+  coinbase::mpc::ecdsa2pc::key_t derived;
+  derived.role = key.role;
+  derived.curve = key.curve;
+  derived.paillier = key.paillier;
+  derived.c_key = key.c_key;
+  derived.Q = key.Q + t * G;
+  if (key.role == coinbase::mpc::party_t::p2) {
+    MODULO(q) derived.x_share = key.x_share + t;
+  } else {
+    derived.x_share = key.x_share;
+  }
+  if (key.curve.check(derived.Q)) return coinbase::error(E_CRYPTO, "derived point invalid");
+  return serialize_key_blob(derived, out_key_blob);
+}
+
+error_t derive_mul_add(mem_t key_blob, mem_t mul, mem_t add, buf_t& out_key_blob) {
+  // Local derivation of `key * mul + add`: Q' = mul*Q + add*G. With the additive sharing
+  // x = x1 + x2, both shares are multiplied by `mul`; P1's Paillier ciphertext c_key = Enc(x1)
+  // becomes Enc(x1 * mul) via deterministic (non-rerandomized) homomorphic scalar
+  // multiplication so both parties hold the same ciphertext; P2 additionally adds `add`.
+  // P1's integer representative x1 * mul stays far below N (x1 < 2q after refresh, mul < q).
+  // Intended for BOLT 3 revocation keys; derived blobs are ephemeral and must not be refreshed.
+  out_key_blob.free();
+  if (const error_t rv = coinbase::api::detail::validate_mem_arg_max_size(key_blob, "key_blob",
+                                                                          coinbase::api::detail::MAX_OPAQUE_BLOB_SIZE))
+    return rv;
+  if (mul.size != 32 || add.size != 32) return coinbase::error(E_BADARG, "mul/add must be 32 bytes");
+
+  coinbase::mpc::ecdsa2pc::key_t key;
+  if (const error_t rv = deserialize_key_blob(key_blob, key)) return rv;
+
+  const mod_t& q = key.curve.order();
+  const auto& G = key.curve.generator();
+  const bn_t m = bn_t::from_bin(mul);
+  const bn_t a = bn_t::from_bin(add);
+  if (m == 0 || m >= q) return coinbase::error(E_BADARG, "mul out of range");
+  if (a >= q) return coinbase::error(E_BADARG, "add out of range");
+
+  coinbase::mpc::ecdsa2pc::key_t derived;
+  derived.role = key.role;
+  derived.curve = key.curve;
+  derived.paillier = key.paillier;
+  derived.c_key = key.paillier.mul_scalar(key.c_key, m, coinbase::crypto::paillier_t::rerand_e::off);
+  derived.Q = m * key.Q + a * G;
+  if (key.role == coinbase::mpc::party_t::p2) {
+    MODULO(q) derived.x_share = key.x_share * m + a;
+  } else {
+    derived.x_share = key.x_share * m;  // plain integer, matches Dec(c_key')
+    if (!key.paillier.get_N().is_in_range(derived.x_share)) return coinbase::error(E_RANGE, "share too large");
+  }
+  if (key.curve.check(derived.Q)) return coinbase::error(E_CRYPTO, "derived point invalid");
+  return serialize_key_blob(derived, out_key_blob);
+}
