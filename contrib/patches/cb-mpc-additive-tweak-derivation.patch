+// Locally derive a key blob for `key + tweak` (tweak: 32-byte big-endian scalar in [1, q)).
+// Non-interactive; both parties apply the same tweak to their blobs of the same key and obtain
+// shares of the derived key, whose public key is Q + tweak*G. Used for Lightning-style
+// additive key derivation (BOLT 3 per-commitment keys).
+error_t derive_additive_tweak(mem_t key_blob, mem_t tweak, buf_t& out_key_blob);
+
+// Locally derive a key blob for `key * mul + add` (32-byte big-endian scalars, mul in [1, q),
+// add in [0, q)). Both parties apply the same values. Public key is mul*Q + add*G. Intended for
+// BOLT 3 revocation keys; derived blobs are ephemeral and must not be refreshed.
+error_t derive_mul_add(mem_t key_blob, mem_t mul, mem_t add, buf_t& out_key_blob);
+
 // Get the compressed public key from a key blob.
 error_t get_public_key_compressed(mem_t key_blob, buf_t& pub_key);
 
