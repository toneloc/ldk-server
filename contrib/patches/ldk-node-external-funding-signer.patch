-					panic!("External funding signer unavailable: cannot derive channel signer");
-				},
+			Some(signer) => {
+				match NodeChannelSigner::with_external(inner, Arc::clone(signer), &self.secp_ctx) {
+					Ok(signer) => signer,
+					Err(()) => {
+						// Without the keys we cannot construct a usable signer, and LDK offers
+						// no way to report failure here. Abort rather than continue with a
+						// signer whose keys would not match the channel's.
+						log_error!(
+							self.logger,
+							"External channel signer failed to provide keys for channel keys id {:?}",
+							channel_keys_id
+						);
+						panic!("External channel signer unavailable: cannot derive channel signer");
+					},
+				}
 			},
